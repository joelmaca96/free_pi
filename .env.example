# Configuración del pipeline (copiar a .env y ajustar)
# Basketball-Reference no requiere API key, pero es buena práctica
# configurar un User-Agent descriptivo y respetar el rate-limiting.

# User-Agent descriptivo (BBR bloquea bots sin UA realista)
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# Retardo entre peticiones en segundos (BBR pide ~20s para no banear)
REQUEST_DELAY=20

# Base de datos (SQLite por defecto para el PoC)
DATABASE_URL=sqlite:///data/baskonia.db

# Temporada a capturar (año de finalización de la temporada)
SEASON=2026

# Equipos de interés (slugs de Basketball-Reference)
# Baskonia aparece como 'vitoria' en BBR (por Vitoria-Gasteiz)
# Bilbao Basket usa el slug 'bilbao'
TEAMS=vitoria

# Ligas a capturar
LEAGUES=acb,euroleague

# Número de partidos recientes de cada equipo cuyo box score se descarga
LAST_N_GAMES=10

# Carpeta donde ingest/baskonia_web descarga las fotos reales de la plantilla
# (ver doc/features/ingestor/01_estado.md, sección baskonia_web)
BASKONIA_WEB_PHOTOS_DIR=data/player_photos

# ---------------------------------------------------------------------------
# Asistente de scouting (pestaña "Asistente", ver
# local/features/005-chatbot/01_design.md §8). Sin ASSISTANT_LLM_MODEL y
# ASSISTANT_LLM_BASE_URL la pestaña se explica sola y no hace nada — el resto
# de la interfaz funciona igual.
#
# El PoC corre a COSTE CERO: cualquier endpoint con capa gratuita que hable el
# dialecto OpenAI vale. Ejemplos verificados (agosto 2026):
#   Groq        https://api.groq.com/openai/v1        (recomendado en desarrollo)
#   Cloudflare  https://api.cloudflare.com/client/v4/accounts/<id>/ai/v1
#   Cerebras    https://api.cerebras.ai/v1
#   Ollama      http://<servidor>:11434/v1            (local, sin clave)
# ---------------------------------------------------------------------------

# openai_compat (por defecto, cubre todo lo de arriba) | anthropic (fase futura)
ASSISTANT_LLM_PROVIDER=openai_compat
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_MODEL=
# Vacía con un modelo local. NUNCA en código ni en el prompt.
ASSISTANT_LLM_API_KEY=

# Baja a propósito: con herramientas, la creatividad solo sirve para elegir peor.
ASSISTANT_LLM_TEMPERATURE=0.2
ASSISTANT_LLM_MAX_TOKENS=1500
ASSISTANT_LLM_TIMEOUT=90

# Respaldo opcional: si el principal falla (cuota agotada, "servicio
# sobrecargado", clave rechazada...), se reintenta UNA vez con este modelo
# antes de dar el turno por perdido (ver app/assistant/llm/fallback.py).
# Vacío por defecto — sin ASSISTANT_LLM_FALLBACK_MODEL no cambia nada.
# PROVIDER/BASE_URL/API_KEY del respaldo caen por defecto en los del
# principal; ponlos solo si el respaldo vive en OTRO proveedor (recomendado:
# así un fallo de infraestructura del principal no se lleva también al
# respaldo por delante).
ASSISTANT_LLM_FALLBACK_MODEL=
ASSISTANT_LLM_FALLBACK_PROVIDER=
ASSISTANT_LLM_FALLBACK_BASE_URL=
ASSISTANT_LLM_FALLBACK_API_KEY=

# Vueltas de herramienta por pregunta y modo de carga del catálogo.
# `by_family` PAGINA el catálogo (no lo recorta) si un modelo pequeño se
# atraganta con las ~25 herramientas de golpe.
ASSISTANT_MAX_TOOL_ITERATIONS=6
ASSISTANT_TOOL_LOADING=eager

# Topes de uso. La app es alcanzable desde internet por el túnel de Cloudflare:
# esto es lo que evita que un visitante agote la cuota gratuita del proveedor.
ASSISTANT_SESSION_LIMIT=30
ASSISTANT_DAILY_LIMIT=200

# Directorio ESCRIBIBLE para el contador diario y los votos del chat. No puede
# ser `data/`: en la Raspberry Pi ese volumen está montado de solo lectura a
# propósito (ver docker-compose.yml). Si se deja vacío, el contador vive en
# memoria y se pierde al reiniciar, pero nada falla.
ASSISTANT_STATE_DIR=data/assistant_state
