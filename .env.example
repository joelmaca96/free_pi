# Configuración del pipeline (copiar a .env y ajustar)
# Basketball-Reference no requiere API key, pero es buena práctica
# configurar un User-Agent descriptivo y respetar el rate-limiting.

# User-Agent descriptivo (BBR bloquea bots sin UA realista)
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36

# Retardo entre peticiones en segundos (BBR pide ~20s para no banear)
REQUEST_DELAY=20

# Base de datos (SQLite por defecto para el PoC)
DATABASE_URL=sqlite:///data/baskonia.db

# Temporada a capturar (año de finalización de la temporada)
SEASON=2026

# Equipos de interés (slugs de Basketball-Reference)
# Baskonia aparece como 'vitoria' en BBR (por Vitoria-Gasteiz)
# Bilbao Basket usa el slug 'bilbao'
TEAMS=vitoria,bilbao

# Ligas a capturar
LEAGUES=acb,euroleague

# Número de partidos recientes de cada equipo cuyo box score se descarga
LAST_N_GAMES=10
